# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Sentry Configuration (optional - only if you want error tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Feature Flags (optional)
FEATURE_WEBHOOK_DEDUPE=true
FEATURE_RATE_LIMITING=true

# Deployment (automatically set by Vercel - DO NOT set manually)
# Vercel automatically injects VERCEL_URL at build/runtime for preview & prod deployments.
# *Do not* set this manually in the dashboard. It contains the host **without protocol**.
# Example preview: preferredsolutionstransport-abc123.vercel.app
# Example prod: preferredsolutionstransport.vercel.app
# The app uses this value to construct redirect URLs for authentication.
VERCEL_URL=

# Base URLs (REQUIRED for production - set to your actual domain)
# NEXT_PUBLIC_SITE_URL is the canonical production domain **with protocol**.
# It is required so Supabase emails (verification, reset) link to the right place.
# Example: https://preferredsolutionstransport.com
NEXT_PUBLIC_SITE_URL=

# NEXT_PUBLIC_BASE_URL is kept for backward compatibility; it should match SITE_URL.
NEXT_PUBLIC_BASE_URL=

# Google Maps API Key (REQUIRED for quote form to work)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# VAPID Keys for Web Push Notifications
# Generate with: node scripts/generate-vapid-keys.js
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Twilio SMS (optional)
# Provide either TWILIO_FROM_NUMBER or TWILIO_MESSAGING_SERVICE_SID
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

